@{
    ViewData["Title"] = "My Garage Sales";
}

<div class="container" x-data="mySalesApp()" x-cloak>

    <!-- Top Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">My Garage Sales</h2>
            <p class="text-muted small mb-0">Manage your active and upcoming listings</p>
        </div>
        <button class="btn btn-primary d-flex align-items-center gap-2" x-on:click="openCreateModal()">
            <span class="fs-5">+</span> Create New Sale
        </button>
    </div>

    <!-- Alert Banner -->
    <template x-if="message">
        <div class="alert alert-dismissible fade show" :class="'alert-' + messageType" role="alert">
            <span x-text="message"></span>
            <button type="button" class="btn-close" x-on:click="message = ''"></button>
        </div>
    </template>

    <!-- Loading State -->
    <div x-show="loading" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Empty State -->
    <div x-show="!loading && garageSales.length === 0" class="text-center py-5 bg-light rounded-3 border">
        <h5 class="text-muted">You haven't posted any garage sales yet.</h5>
        <p class="text-muted small">Click "Create New Sale" to publish your first listing in Palm Coast.</p>
    </div>

    <!-- Listings Table -->
    <div x-show="!loading && garageSales.length > 0" class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap" style="width: 14%;">Address</th>
                        <th class="text-nowrap" style="width: 17%;">Sale Type</th>
                        <th style="width: 51%;">Description</th>
                        <th class="text-nowrap" style="width: 5%;">Owner</th>
                        <th class="text-nowrap text-end" style="width: 13%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="sale in garageSales" :key="sale.id">
                        <tr>
                            <td class="text-nowrap fw-semibold text-primary" x-text="sale.street"></td>
                            <td class="text-nowrap" x-text="sale.saleType"></td>
                            <td class="text-muted text-truncate" style="max-width: 350px;" x-text="sale.description"></td>
                            <td class="text-nowrap" x-text="sale.owner"></td>
                            <td class="text-nowrap text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary"
                                            x-on:click="openEditModal(sale)">Edit</button>
                                    <button class="btn btn-outline-danger"
                                            x-on:click="deleteSale(sale.id)">Delete</button>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_EditSaleModal" />

</div>

@section Scripts {
    <script src="~/js/datetime-helpers.js" asp-append-version="true"></script>
    <script src="~/js/edit-sale-modal.js" asp-append-version="true"></script>
    <script>
        function mySalesApp() {
            return {
                ...modalLogic(),

                garageSales: [],

                init() {
                    this.initModal();
                    this.fetchMySales();
                },

                async fetchMySales() {
                    this.loading = true;
                    try {
                        const response = await fetch('https://localhost:7285/api/mygaragesales', {
                            credentials: 'include'
                        });
                        if (response.ok) {
                            this.garageSales = await response.json();
                            console.log(this.garageSales);
                        }
                    } catch (err) {
                        this.showMessage('Failed to load garage sales', 'danger');
                    } finally {
                        this.loading = false;
                    }
                },

                async deleteSale(saleId) {
                    if (!saleId) return;

                    if (!confirm('Are you sure you want to delete this garage sale listing? This action cannot be undone.')) {
                        return;
                    }

                    try {
                        const response = await fetch(`https://localhost:7285/api/garagesales/${saleId}`, {
                            method: 'DELETE',
                            credentials: 'include'
                        });

                        if (response.ok) {
                            this.showMessage('Listing deleted successfully!', 'success');
                            await this.fetchMySales();
                        } else {
                            this.showMessage('Failed to delete garage sale.', 'danger');
                        }
                    } catch (err) {
                        this.showMessage('Network error while attempting to delete.', 'danger');
                    }
                },

                message:'',

                showMessage(msg, type = 'success') {
                    this.message = msg;
                    this.messageType = type;
                }
            };
        }
    </script>
}