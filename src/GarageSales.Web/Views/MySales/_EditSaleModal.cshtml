<div class="modal fade" id="editSaleModal" tabindex="-1" aria-hidden="true" ref="modalElement">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" x-text="isEditing ? 'Edit Garage Sale #' + form.id : 'Create New Garage Sale'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form class="modal-body p-4" x-on:submit.prevent="saveSale()">
                    
                    <!-- Section 1: Core Sale Details -->
                    <h6 class="fw-bold text-primary mb-3">Location & Type</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Street Address <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" x-model="form.street" required placeholder="e.g. 123 Palm Coast Pkwy">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Zip Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" x-model="form.zip" required placeholder="32137" pattern="[0-9]{5}">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Sale Type <span class="text-danger">*</span></label>
                            <select class="form-select" x-model="form.saleType" required>
                                <option value="">Select Sale Type...</option>
                                <template x-for="type in lookups.garageSaleTypes" :key="type.id">
                                    <option :value="type.name" x-text="type.name"></option>
                                </template>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">General Description</label>
                            <textarea class="form-control" x-model="form.description" rows="2" placeholder="General info, parking notes..."></textarea>
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Section 2: Dynamic Schedules -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-primary mb-0">Schedules & Hours <span class="text-danger">*</span></h6>
                            <small class="text-muted">Add dates and times for when the sale will be active</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" x-on:click="addSchedule()">
                            + Add Schedule
                        </button>
                    </div>

                    <template x-if="form.schedules.length === 0">
                        <div class="alert alert-warning py-2 text-center small mb-3">
                            At least one schedule date/time is required. Click <strong>+ Add Schedule</strong> above.
                        </div>
                    </template>

                    <div class="d-flex flex-column gap-2 mb-4">
                        <template x-for="(schedule, index) in form.schedules" :key="index">
                            <div class="card bg-light border-0 p-3">
                                <div class="row g-2 align-items-center">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-semibold mb-1">Start Date & Time</label>
                                        <input type="datetime-local" class="form-control form-control-sm" x-model="schedule.from" required>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small fw-semibold mb-1">End Date & Time</label>
                                        <input type="datetime-local" class="form-control form-control-sm" x-model="schedule.to" required>
                                    </div>
                                    <div class="col-md-2 text-end pt-3">
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100" x-on:click="removeSchedule(index)">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                    <hr class="my-4">

                    <!-- Section 3: Dynamic Featured Items -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold text-primary mb-0">Featured Items</h6>
                            <small class="text-muted">Highlight specific items available at your sale</small>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" x-on:click="addFeaturedItem()">
                            + Add Item
                        </button>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <template x-for="(item, index) in form.featuredItems" :key="index">
                            <div class="card border p-3">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold mb-1">Item Category</label>
                                        <select class="form-select" x-model="item.category" required>
                                            <option value="">Select Item Category...</option>
                                            <template x-for="cat in lookups.itemCategories" :key="cat.id">
                                                <option :value="cat.name" x-text="cat.name" :selected="item.category === cat.name"></option>
                                            </template>
                                        </select>
                                    </div>
                                    
                                    <div class="col-4">
                                        <label class="form-label small fw-semibold mb-1">Item Name</label>
                                        <input type="text" class="form-control form-control-sm" x-model="item.name">
                                    </div>

                                    <div class="col-2">
                                        <label class="form-label small fw-semibold mb-1">Item Price</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm" x-model="item.price">
                                    </div>

                                    <div class="col-10">
                                        <label class="form-label small fw-semibold mb-1">Item Description</label>
                                        <input type="text" class="form-control form-control-sm" x-model="item.description" placeholder="Optional details">
                                    </div>
                                    <div class="col-md-2 flex-row-reverse align-items-end pt-3">
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100" x-on:click="removeFeaturedItem(index)">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" :disabled="saving || form.schedules.length === 0">
                        <span x-show="saving" class="spinner-border spinner-border-sm me-1"></span>
                        <span x-text="isEditing ? 'Save Changes' : 'Publish Listing'"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>