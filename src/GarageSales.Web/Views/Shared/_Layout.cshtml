@{
    string IsActive(string controllerName)
    {
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        if(currentController is null)
        {
          return string.Empty;
        }
        return string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }
}

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Palm Coast Garage Sales</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<!-- d-flex + flex-column = stack child elements vertically -->
<body class="d-flex flex-column h-100">
  <header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Palm Coast Garage Sale Listings</a>
        
        <!-- Hamburger button for small displays -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Navigation links -->
        <div class="collapse navbar-collapse text-body" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link @IsActive("Home")" asp-controller="Home" asp-action="Index">Find Sales</a>
            </li>
            <li class="nav-item">
              <a class="nav-link @IsActive("MySales")" asp-controller="MySales" asp-action="Index"">
                @(User.IsInRole("Admin") ? "All Listings (Admin)" : "My Listings")
              </a>
            </li>
            <li class="nav-item" x-data=navbarLogic()>
              @if(User.Identity?.IsAuthenticated == true)
              {
                <a class="nav-link" href="#" x-on:click.prevent="logout()">Log out (@User.Identity.Name)</a>
              }
              else
              {
                <a class="nav-link" href="#">Log in</a>
              }
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <!-- Main Content Body -->
  <main class="flex-shrink-0 my-4">
      @RenderBody()
  </main>

  <footer class="mt-auto py-3 bg-body-tertiary border-top">
    <div class="container text-center text-body-secondary">
      <small>&copy; @DateTime.Now.Year City of Palm Coast</small>
    </div>
  </footer>

  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  <script src="~/js/alpine-navbar.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>